{
  "name": "nocturne-studio",
  "version": "1.0.0",
  "description": "Nocturne Studio Precision Karaoke & Vocal Engine",
  "author": "",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "app": "electron .",
    "electron": "electron .",
    "build:exe": "electron-builder --win",
    "test": "node test-full-loop.js",
    "test:edge": "node test-edge-cases.js",
    "test:cable": "node test-cable-simulation.js",
    "test:visual": "electron visual-tester.js",
    "test:all": "node test-full-loop.js && node test-edge-cases.js && node test-cable-simulation.js"
  },
  "build": {
    "appId": "com.nocturne.studio",
    "productName": "Nocturne Studio",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nocturne Studio",
      "include": "installer.nsh"
    },
    "extraResources": [
      {
        "from": "resources/driver",
        "to": "driver"
      },
      {
        "from": "resources/bin",
        "to": "bin"
      }
    ]
  },
  "keywords": [],
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "yt-search": "^2.13.1"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  }
}
