{
  "version": 3,
  "routes": [
    {
      "src": "^/api/search$",
      "dest": "/api/search.js"
    },
    {
      "src": "^/api/audio$",
      "dest": "/api/audio.js"
    },
    {
      "src": "^/(.*)$",
      "dest": "/public/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/api(/.*)?$",
      "status": 404
    },
    {
      "handle": "error"
    },
    {
      "status": 404,
      "src": "^(?!/api).*$",
      "dest": "/404.html"
    },
    {
      "handle": "miss"
    },
    {
      "src": "^/api/(.+)(?:\\.(?:js))$",
      "dest": "/api/$1",
      "check": true
    }
  ],
  "framework": {
    "slug": "express",
    "version": "5.2.1"
  },
  "crons": []
}
